{
  "manifest_version": 3,
  "name": "KeyPilot by AQERIONX",
  "version": "2.2.1",
  "description": "Keyboard navigation plus CCBP-focused Smart Dark Mode and a reversible fallback for other websites.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyPilot by AQERIONX"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
