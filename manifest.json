{
  "manifest_version": 3,
  "name": "KeyPilot by AQERIONX",
  "version": "2.2.6",
  "description": "Adaptive quiz-option detection with runtime fallback recovery, persistent CCBP route support, adaptive Smart Dark Mode, and practice-only submit shortcuts.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyPilot by AQERIONX"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://learning.ccbp.in/*",
    "http://*/*",
    "https://*/*"
  ]
}
