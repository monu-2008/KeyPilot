{
  "manifest_version": 3,
  "name": "KeyPilot by AQERIONX",
  "version": "2.2.12",
  "description": "Adaptive quiz-option detection, all-sites Enter/Space-to-submit, Shift+Enter for next question, adaptive Smart Dark Mode.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyPilot by AQERIONX"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://learning.ccbp.in/*",
    "http://*/*",
    "https://*/*"
  ]
}
